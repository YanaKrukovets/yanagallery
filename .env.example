# Copy this file to .env.local and fill in your keys.
# Get them at https://dashboard.stripe.com/test/apikeys (test mode first).
# Never commit .env.local or share the secret key.
STRIPE_SECRET_KEY=sk_test_...

# Your live site address, https://ottawaartist.ca. Used for Stripe return links; search tags fall back to ottawaartist.ca when unset.
SITE_URL=
